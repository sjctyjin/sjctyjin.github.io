  <!-- 第2台相機：掛在 arm2link6 -->
  <!---->
  <!-- 2) 建立相機的 base_link（加 prefix 避免多台相機衝突）-->
  <link name="cam2_d405_base_link"/>
  <!-- 3) 用一個固定 joint 來把相機掛到 parent_link 上 -->
  <joint name="cam2_d405_joint" type="fixed">
    <origin rpy="-0.29119 0.016918 -1.6641" xyz="-0.06092 0.00551 0.030946"/>
    <parent link="arm2_link6"/>
    <child link="cam2_d405_base_link"/>
