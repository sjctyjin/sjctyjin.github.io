  <!-- 第2台相機：掛在 arm2link6 -->
  <!---->
  <!-- 2) 建立相機的 base_link（加 prefix 避免多台相機衝突）-->
  <link name="cam2_d435_base_link"/>
  <!-- 3) 用一個固定 joint 來把相機掛到 parent_link 上 -->
  <joint name="cam2_d435_joint" type="fixed">
    <origin rpy="-1.57 -1.57 0" xyz="0.0 0.08 0.02"/>
    <parent link="arm2link6"/>
    <child link="cam2_d435_base_link"/>
  </joint>
  <!-- camera body, with origin at bottom screw mount -->
  <joint name="cam2_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="cam2_d435_base_link"/>
    <child link="cam2_bottom_screw_frame"/>
  </joint>
  <link name="cam2_bottom_screw_frame"/>
  <joint name="cam2_link_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.010600000000000002 0.0175 0.0125"/>
    <parent link="cam2_bottom_screw_frame"/>
    <child link="cam2_link"/>
  </joint>
  <link name="cam2_link">
    <visual>
      <!-- the mesh origin is at front plate in between the two infrared camera axes -->
      <origin rpy="1.5707963267948966 0 1.5707963267948966" xyz="0.0043 -0.0175 0"/>
      <geometry>
        <mesh filename="file:///home/ros2/github/dual_arm_ws/install/realsense2_description/share/realsense2_description/dual_meshes/d435.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 -0.0175 0"/>
      <geometry>
        <box size="0.02505 0.09 0.025"/>
      </geometry>
    </collision>
    <inertial>
      <!-- The following are not reliable values, and should not be used for modeling -->
      <mass value="0.072"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.003881243" ixy="0.0" ixz="0.0" iyy="0.000498940" iyz="0.0" izz="0.003879257"/>
    </inertial>
  </link>
